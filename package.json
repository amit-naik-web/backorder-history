{
  "name": "backorder-history",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.7.0",
    "@sap/cds": "^9",
    "@sap/hana-client": "^2.28.19",
    "@sap/xssec": "^4.13.0",
    "cors": "^2.8.6",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-backorder-ui": "cds watch --open backorder.app.backorderui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy backorder-history --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana-cloud"
      },
      "auth": {
        "kind": "dummy"
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ]
}
